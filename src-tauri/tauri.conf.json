{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heartopia Photo Tool",
  "version": "0.1.0",
  "identifier": "io.github.airisua.heartopia-photo-tool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Heartopia 图片解密",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Offline batch photo decryptor for Heartopia",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBRjQxODk3RDJENDQ0MTgKUldRWVJOVFNseGowNnJ1aStPSWJBbFpWRTBYSmlKOGErM2FsQ3BIQVAxMUZUVFcvL1J4eUlPK0oK",
      "endpoints": [
        "https://github.com/Airisua/heartopia-photo-tool/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
